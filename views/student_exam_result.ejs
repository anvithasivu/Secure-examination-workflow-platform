<!DOCTYPE html>
<html>

<head>
    <title>Exam Result - <%= result.course_name %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="app-shell">
        <div class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="/student-dashboard">Secure Exam</a>
                <div class="nav-group">
                    <a class="btn btn-ghost" href="/student-dashboard">Dashboard</a>
                    <a class="btn btn-danger" href="/logout">Logout</a>
                </div>
            </div>
        </div>

        <div class="container">
            <h1 class="page-title">Exam Result</h1>
            <p class="page-subtitle"><%= result.course_name %></p>

            <% 
                // Source of truth for percentage is the database score (final calculated percentage)
                const overallPct = Number(result.score || 0);
                
                // Other fields are used for display; if they aren't passed via query string (e.g. after refresh), they fallback to 0
                const correctCount = typeof correct !== 'undefined' ? Number(correct) : 0;
                const marksSecured = typeof marks !== 'undefined' ? Number(marks) : 0;
                const totalQ = typeof total !== 'undefined' ? Number(total) : 40; 
            %>

            <div class="grid">
                <div class="col-12">
                    <div class="card" style="text-align: center; padding: 32px;">
                        <h3 class="card-title">Overall Percentage</h3>
                        <div style="font-size: 56px; font-weight: 900; color: var(--primary);"><%= overallPct.toFixed(2) %>%</div>
                        
                        <div style="margin-top: 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div class="card" style="background: var(--surface-2); border: none;">
                                <div style="opacity: 0.7; font-size: 14px; font-weight: 700; text-transform: uppercase;">Correct Answers</div>
                                <div style="font-size: 24px; font-weight: 800; margin-top: 4px;"><%= correctCount %> / <%= totalQ %></div>
                            </div>
                            <div class="card" style="background: var(--surface-2); border: none;">
                                <div style="opacity: 0.7; font-size: 14px; font-weight: 700; text-transform: uppercase;">Marks Secured</div>
                                <div style="font-size: 24px; font-weight: 800; margin-top: 4px;"><%= marksSecured.toFixed(2) %></div>
                            </div>
                        </div>

                        <div style="margin-top: 24px; padding: 12px; border-radius: 12px; display: inline-block; font-weight: 800; background: <%= overallPct >= 60 ? 'rgba(39, 174, 96, 0.12)' : 'rgba(214, 90, 90, 0.12)' %>; color: <%= overallPct >= 60 ? '#27ae60' : '#D65A5A' %>;">
                            <%= overallPct >= 60 ? 'PASSED' : 'FAILED' %> — Minimum 60% required.
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card">
                        <div class="card-actions">
                            <a href="/student-levels/<%= result.course_id %>" class="btn btn-secondary">Back to Course</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>