<!DOCTYPE html>
<html>

<head>
    <title>Exam Result - <%= result.course_name %>
    </title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #e6e6fa;
            color: #4a235a;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .result-card {
            background-color: #fdfefe;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(100, 80, 150, 0.2);
            text-align: center;
            max-width: 500px;
            width: 90%;
        }

        h1 {
            color: #716499;
            margin-bottom: 30px;
        }

        .score-circle {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background-color: #b8c0ff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            margin: 0 auto 30px;
            border: 8px solid #c9b1de;
        }

        .score-value {
            font-size: 48px;
            font-weight: bold;
            color: #4a235a;
        }

        .score-label {
            font-size: 14px;
            color: #4a235a;
            opacity: 0.8;
        }

        .status {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .pass {
            color: #27ae60;
        }

        .fail {
            color: #e74c3c;
        }

        .details {
            text-align: left;
            margin-bottom: 30px;
            background-color: #f7f1fa;
            padding: 20px;
            border-radius: 10px;
        }

        .details p {
            margin: 10px 0;
            line-height: 1.5;
        }

        .btn {
            display: inline-block;
            padding: 12px 25px;
            background-color: #b8c0ff;
            color: #4a235a;
            font-weight: bold;
            text-decoration: none;
            border-radius: 8px;
            transition: 0.3s;
        }

        .btn:hover {
            background-color: #9ba7f5;
            color: #fff;
        }
    </style>
</head>

<body>
    <div class="result-card">
        <h1>Exam Result</h1>

        <div class="score-circle">
            <div class="score-value">
                <%= result.score %>
            </div>
            <div class="score-label">Total Marks</div>
        </div>

        <div class="status <%= result.score >= 60 ? 'pass' : 'fail' %>">
            <%= result.score>= 60 ? 'CONGRATULATIONS! LEVEL CLEARED' : 'LEVEL NOT CLEARED' %>
        </div>

        <div class="details">
            <p><strong>Course:</strong>
                <%= result.course_name %>
            </p>
            <p><strong>Level:</strong>
                <%= result.level %>
            </p>
            <p><strong>Attempts:</strong>
                <%= result.attempts %>
            </p>
            <p><strong>Score:</strong>
                <%= result.score %>%
            </p>
        </div>

        <a href="/student-levels/<%= result.course_id %>" class="btn">Return to Levels</a>
    </div>
</body>

</html>