<!DOCTYPE html>
<html>

<head>
    <title>Exam Result - <%= result.course_name %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="app-shell">
        <div class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="/student-dashboard">Secure Exam</a>
                <div class="nav-group">
                    <a class="btn btn-ghost" href="/student-dashboard">Dashboard</a>
                    <a class="btn btn-danger" href="/logout">Logout</a>
                </div>
            </div>
        </div>

        <div class="container">
            <h1 class="page-title">Exam Result</h1>
            <p class="page-subtitle"><%= result.course_name %></p>

            <div class="grid">
                <div class="col-12">
                    <div class="card">
                        <h3 class="card-title">Score</h3>
                        <div style="font-size: 40px; font-weight: 900;"><%= result.score %>%</div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card">
                        <div class="card-actions">
                            <a href="/student-levels/<%= result.course_id %>" class="btn btn-secondary">Back to Course</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>