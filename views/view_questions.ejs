<!DOCTYPE html>
<html>

<head>
  <title>View Questions</title>
  <link rel="stylesheet" href="/style.css">
  <script>
    function filterQuestions() {
      const course = document.getElementById("courseFilter").value;
      const level = document.getElementById("levelFilter").value;
      window.location.href = `/view-questions?course_id=${course}&level=${level}`;
    }
  </script>
</head>

<body>
  <div class="app-shell">
    <div class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="<%= user.role === 'admin' ? '/admin' : '/teacher-dashboard' %>">Secure Exam</a>
        <div class="nav-group">
          <a class="btn btn-ghost" href="<%= user.role === 'admin' ? '/admin' : '/teacher-dashboard' %>">Dashboard</a>
          <a class="btn btn-danger" href="/logout">Logout</a>
        </div>
      </div>
    </div>

    <div class="container">
      <h1 class="page-title">Question Bank</h1>
      <p class="page-subtitle">Filter by course and level to manage MCQ questions.</p>

      <div class="card">
        <div class="row">
          <div>
            <label><strong>Course</strong></label>
            <select class="field" id="courseFilter" onchange="filterQuestions()">
              <option value="0">-- All Courses --</option>
              <% courses.forEach(c=> { %>
                <option value="<%= c.id %>" <%=selectedCourse==c.id ? "selected" : "" %>><%= c.course_name %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label><strong>Level</strong></label>
            <select class="field" id="levelFilter" onchange="filterQuestions()">
              <option value="0">-- All Levels --</option>
              <% for(let i=1;i<=10;i++){ %>
                <option value="<%= i %>" <%=selectedLevel==i ? "selected" : "" %>>Level <%= i %></option>
              <% } %>
            </select>
          </div>
        </div>
      </div>

      <div class="card" style="margin-top: 16px;">
        <h3 class="card-title">MCQ Questions</h3>
        <table class="table">
          <tr>
            <th>S.No</th>
            <th>Question</th>
            <th>Option 1</th>
            <th>Option 2</th>
            <th>Option 3</th>
            <th>Option 4</th>
            <th>Correct</th>
            <th>Action</th>
          </tr>
          <% if(mcqQuestions.length===0){ %>
            <tr>
              <td colspan="8" style="text-align:center;">No MCQs found</td>
            </tr>
          <% } %>
          <% let counter=1; mcqQuestions.forEach(q=> { %>
            <tr>
              <td>
                <%= counter++ %>
              </td>
              <td>
                <%= q.question %>
              </td>
              <td>
                <%= q.option1 %>
              </td>
              <td>
                <%= q.option2 %>
              </td>
              <td>
                <%= q.option3 %>
              </td>
              <td>
                <%= q.option4 %>
              </td>
              <td>
                <%= q.correct %>
              </td>
              <td>
                <a href="/delete-question/<%= q.id %>" class="btn btn-danger" style="padding: 8px 10px;">Delete</a>
              </td>
            </tr>
          <% }) %>
        </table>
      </div>
    </div>
  </div>
</body>

</html>