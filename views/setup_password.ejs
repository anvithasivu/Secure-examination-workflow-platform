<!DOCTYPE html>
<html>

<head>
    <title>Set Your Password</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #e6e6fa;
            color: #4a235a;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .container {
            background-color: #e8daef;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(100, 80, 150, 0.2);
            width: 350px;
            text-align: center;
        }

        h2 {
            color: #716499;
            margin-bottom: 20px;
        }

        input {
            width: 100%;
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 6px;
            border: 1px solid #c9b1de;
            box-sizing: border-box;
        }

        button {
            width: 100%;
            padding: 12px;
            background-color: #b8c0ff;
            color: #4a235a;
            font-weight: bold;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.3s;
        }

        button:hover {
            background-color: #9ba7f5;
        }
    </style>
</head>

<body>
    <div class="container">
        <h2>Set Your Password</h2>
        <p>This is your first login. Please set a password for your account.</p>
        <form action="/setup-password" method="POST">
            <input type="password" name="password" placeholder="Enter New Password" required minlength="6">
            <button type="submit">Set Password & Login</button>
        </form>
    </div>
</body>

</html>