<!DOCTYPE html>
<html>

<head>
    <title>Set Your Password</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="app-shell">
        <div class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="/">Secure Exam</a>
            </div>
        </div>

        <div class="container">
            <div class="grid">
                <div class="col-12">
                    <div class="card" style="max-width: 460px; margin: 24px auto;">
                        <h1 class="page-title" style="text-align:center;">Set Your Password</h1>
                        <p class="page-subtitle" style="text-align:center;">First login detected. Please set a new password.</p>

                        <form action="/setup-password" method="POST" class="stack">
                            <input class="field" type="password" name="password" placeholder="Enter New Password" required minlength="6">
                            <button class="btn" type="submit" style="width:100%;">Set Password & Login</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>