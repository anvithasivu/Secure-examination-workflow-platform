<!DOCTYPE html>
<html>

<head>
    <title>View Results</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="app-shell">
        <div class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="<%= user.role === 'admin' ? '/admin' : '/teacher-dashboard' %>">Secure Exam</a>
                <div class="nav-group">
                    <a class="btn btn-ghost" href="<%= user.role === 'admin' ? '/admin' : '/teacher-dashboard' %>">Dashboard</a>
                    <a class="btn btn-danger" href="/logout">Logout</a>
                </div>
            </div>
        </div>

        <div class="container">
            <h1 class="page-title">Student Results</h1>
            <p class="page-subtitle">Course-wise performance overview.</p>

            <% if (groupedResults) { %>
                <% const courseNames = Object.keys(groupedResults); %>
                <% if (courseNames.length === 0) { %>
                    <div style="opacity: 0.8;">No results found.</div>
                <% } else { %>
                    <% courseNames.forEach(courseName => { %>
                        <div class="card" style="margin-top: 16px;">
                            <h3 class="card-title"><%= courseName %></h3>
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Student Username</th>
                                        <th>Level</th>
                                        <th>Score</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% groupedResults[courseName].forEach(result => { %>
                                        <tr>
                                            <td><%= result.username %></td>
                                            <td><%= result.level %></td>
                                            <td><%= result.score %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% }) %>
                <% } %>
            <% } else { %>
                <% if (results && results.length> 0) { %>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Student Username</th>
                                <th>Course</th>
                                <th>Level</th>
                                <th>Score</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% results.forEach(result=> { %>
                                <tr>
                                    <td><%= result.username %></td>
                                    <td><%= result.course_name %></td>
                                    <td><%= result.level %></td>
                                    <td><%= result.score %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <div style="opacity: 0.8;">No results found.</div>
                <% } %>
            <% } %>
        </div>
    </div>
</body>

</html>