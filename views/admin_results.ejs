<!DOCTYPE html>
<html>

<head>
    <title>View Results</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #e6e6fa;
            color: #4a235a;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 900px;
            margin: 40px auto;
            background-color: #e8daef;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(100, 80, 150, 0.2);
        }

        h2 {
            color: #716499;
            text-align: center;
            margin-bottom: 30px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background-color: #fdfefe;
            border-radius: 8px;
            overflow: hidden;
        }

        table,
        th,
        td {
            border: 1px solid #c9b1de;
        }

        th,
        td {
            text-align: left;
            padding: 12px;
        }

        th {
            background-color: #b8c0ff;
            color: #4a235a;
        }

        tr:nth-child(even) {
            background-color: #f7f1fa;
        }

        .btn-back {
            display: inline-block;
            margin-bottom: 20px;
            text-decoration: none;
            color: #fff;
            background-color: #c9b1de;
            padding: 10px 15px;
            border-radius: 6px;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn-back:hover {
            background-color: #b8c0ff;
            color: #4a235a;
        }
    </style>
</head>

<body>

    <div class="container">
        <a href="<%= user.role === 'admin' ? '/admin' : '/teacher-dashboard' %>" class="btn-back">&larr; Back to
            Dashboard</a>
        <h2>Student Results Overview</h2>

        <% if (results && results.length> 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>Student Username</th>
                        <th>Course</th>
                        <th>Level</th>
                        <th>Score</th>
                    </tr>
                </thead>
                <tbody>
                    <% results.forEach(result=> { %>
                        <tr>
                            <td>
                                <%= result.username %>
                            </td>
                            <td>
                                <%= result.course_name %>
                            </td>
                            <td>
                                <%= result.level %>
                            </td>
                            <td>
                                <%= result.score %>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
            <% } else { %>
                <p style="text-align: center; color: #666;">No results found.</p>
                <% } %>
    </div>

</body>

</html>