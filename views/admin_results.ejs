<!DOCTYPE html>
<html>

<head>
    <title>View Results</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="app-shell">
        <div class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="<%= user.role === 'admin' ? '/admin' : '/teacher-dashboard' %>">Secure Exam</a>
                <div class="nav-group">
                    <a class="btn btn-ghost" href="<%= user.role === 'admin' ? '/admin' : '/teacher-dashboard' %>">Dashboard</a>
                    <a class="btn btn-danger" href="/logout">Logout</a>
                </div>
            </div>
        </div>

        <div class="container">
            <h1 class="page-title">Student Results</h1>
            <p class="page-subtitle">Course-wise and level-wise performance overview.</p>

            <% if (results && results.length> 0) { %>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Student Username</th>
                            <th>Course</th>
                            <th>Level</th>
                            <th>Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% results.forEach(result=> { %>
                            <tr>
                                <td><%= result.username %></td>
                                <td><%= result.course_name %></td>
                                <td><%= result.level %></td>
                                <td><%= result.score %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <div style="opacity: 0.8;">No results found.</div>
            <% } %>

            <div style="margin-top: 16px;">
                <a href="<%= user.role === 'admin' ? '/admin' : '/teacher-dashboard' %>" class="btn btn-secondary">Back to Dashboard</a>
            </div>
        </div>
    </div>
</body>

</html>