<!DOCTYPE html>
<html>

<head>
    <title>Manage Course - <%= course.course_name %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="app-shell">
        <div class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="<%= user.role === 'admin' ? '/admin/manage-courses' : '/teacher-dashboard' %>">Secure Exam</a>
                <div class="nav-group">
                    <a class="btn btn-ghost" href="<%= user.role === 'admin' ? '/admin/manage-courses' : '/teacher-dashboard' %>">Dashboard</a>
                    <a class="btn btn-danger" href="/logout">Logout</a>
                </div>
            </div>
        </div>

        <div class="container">
            <h1 class="page-title">Manage Course</h1>
            <p class="page-subtitle"><strong><%= course.course_name %></strong> — manage levels and questions.</p>

            <div class="card">
                <h3 class="card-title">Levels</h3>
                <div id="levels-list" class="stack">
                    <% levels.forEach(level=> { %>
                        <div class="card">
                            <div class="card-header">
                                <div>
                                    <%= level.level_name %>
                                </div>
                                <div class="card-actions">
                                    <a href="/view-questions?course_id=<%= course.id %>&level=<%= level.level_number %>" class="btn btn-secondary">View Questions</a>
                                    <% if (canEdit) { %>
                                        <a href="/add-question?course_id=<%= course.id %>&level=<%= level.level_number %>" class="btn">Add Question</a>
                                        <button data-id="<%= level.id %>" data-name="<%= level.level_name %>" onclick="renameLevelBtn(this)" class="btn btn-ghost" type="button">Rename</button>
                                        <form action="/course/remove-specific-level" method="POST"
                                            onsubmit="return confirm('Remove this level and all its questions?');">
                                            <input type="hidden" name="course_id" value="<%= course.id %>">
                                            <input type="hidden" name="level_id" value="<%= level.id %>">
                                            <button type="submit" class="btn btn-danger">Remove</button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <% if (canEdit) { %>
                    <form action="/course/add-new-level" method="POST" class="text-center">
                        <input type="hidden" name="course_id" value="<%= course.id %>">
                        <button type="submit" class="btn">Add New Level</button>
                    </form>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        function renameLevelBtn(btn) {
            const id = btn.getAttribute('data-id');
            const oldName = btn.getAttribute('data-name');
            const newName = prompt("Enter new name for the level:", oldName);
            if (newName && newName !== oldName) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/course/rename-level';

                const idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'level_id';
                idInput.value = id;
                form.appendChild(idInput);

                const nameInput = document.createElement('input');
                nameInput.type = 'hidden';
                nameInput.name = 'level_name';
                nameInput.value = newName;
                form.appendChild(nameInput);

                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>

</html>