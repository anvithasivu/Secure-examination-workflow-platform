<!DOCTYPE html>
<html>

<head>
    <title>Manage Users</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="app-shell">
        <div class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="<%= user.role === 'academic_coordinator' ? '/coordinator' : '/admin' %>">Secure
                    Exam</a>
                <div class="nav-group">
                    <a class="btn btn-ghost"
                        href="<%= user.role === 'academic_coordinator' ? '/coordinator' : '/admin' %>">Dashboard</a>
                    <a class="btn btn-danger" href="/logout">Logout</a>
                </div>
            </div>
        </div>

        <div class="container">
            <h1 class="page-title">User Management</h1>
            <p class="page-subtitle">
                <%= user.role==='academic_coordinator' ? 'Create teacher accounts and manage student/teacher access.'
                    : 'Oversight view — monitor users and remove accounts if required.' %>
            </p>

            <div class="card" style="margin-bottom: 16px;">
                <div class="card-actions">
                    <button type="button" class="btn" id="btn_tab_students"
                        onclick="showTab('students')">Students</button>
                    <button type="button" class="btn btn-secondary" id="btn_tab_teachers"
                        onclick="showTab('teachers')">Teachers</button>
                    <button type="button" class="btn btn-secondary" id="btn_tab_requests"
                        onclick="showTab('requests')">Password Requests <% if(pwdRequests && pwdRequests.length> 0) {
                            %><span class="badge" style="background: var(--danger); color: white; margin-left: 6px;">
                                <%= pwdRequests.length %>
                            </span>
                            <% } %></button>
                </div>
            </div>

            <div class="grid">
                <% if (user.role==='academic_coordinator' ) { %>
                    <div class="col-12">
                        <div class="card">
                            <h3 class="card-title">Add New Teacher</h3>

                            <form action="/coordinator/add-teacher" method="POST" class="row">
                                <input class="field" type="text" name="username" placeholder="Teacher Username"
                                    required>
                                <select class="field" name="course_id" multiple required
                                    style="height: auto; min-height: 80px;" title="Hold Ctrl/Cmd to select multiple">
                                    <option value="" disabled>Assign to Course(s)</option>
                                    <% courses.forEach(course=> { %>
                                        <option value="<%= course.id %>">
                                            <%= course.course_name %>
                                        </option>
                                        <% }) %>
                                </select>
                                <button type="submit" class="btn">Create Teacher Account</button>
                            </form>

                            <div class="alert alert-info">
                                <strong>Default Password:</strong> All new teachers are assigned
                                <code>teacherlogin</code>
                                as their initial password and will be prompted to change it upon login.
                            </div>
                        </div>
                    </div>
                    <% } %>

                        <div class="col-12" id="tab_students">
                            <div class="card">
                                <h3 class="card-title">Registered Students</h3>
                                <% if (students && students.length> 0) { %>

                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Username</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% students.forEach(student=> { %>
                                                <tr>
                                                    <td>
                                                        <%= student.username %>
                                                    </td>
                                                    <td>
                                                        <form action="/admin/delete-user" method="POST"
                                                            onsubmit="return confirm('Are you sure you want to remove this student? They will need to register again to regain access.');">
                                                            <input type="hidden" name="user_id"
                                                                value="<%= student.id %>">
                                                            <button type="submit" class="btn btn-danger">Remove</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                    <% } else { %>
                                        <div class="alert alert-empty">No students found.</div>
                                        <% } %>
                            </div>
                        </div>

                        <div class="col-12" id="tab_teachers" style="display:none;">
                            <div class="card">
                                <h3 class="card-title">Teachers</h3>
                                <% if ((activeTeachers && activeTeachers.length> 0) || (pendingTeachers &&
                                    pendingTeachers.length> 0)) { %>
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Username</th>
                                                <th>Course(s)</th>
                                                <th>Status</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% activeTeachers.forEach(teacher=> { %>
                                                <tr>
                                                    <td>
                                                        <%= teacher.username %>
                                                    </td>
                                                    <td>
                                                        <%= (teacherCoursesMap && teacherCoursesMap[teacher.id] &&
                                                            teacherCoursesMap[teacher.id].length> 0) ?
                                                            teacherCoursesMap[teacher.id].join(', ') : '-' %>
                                                    </td>
                                                    <td>Active</td>
                                                    <td>
                                                        <div style="display: flex; gap: 8px;">
                                                            <button type="button" class="btn"
                                                                style="background: var(--surface); color: var(--primary); border: 1px solid var(--border);"
                                                                onclick="openEditModal('<%= teacher.id %>', '<%= teacher.username %>')">Edit</button>
                                                            <form action="/admin/delete-user" method="POST"
                                                                onsubmit="return confirm('Are you sure you want to remove this teacher?');"
                                                                style="margin: 0;">
                                                                <input type="hidden" name="user_id"
                                                                    value="<%= teacher.id %>">
                                                                <button type="submit"
                                                                    class="btn btn-danger">Remove</button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }) %>

                                                    <% pendingTeachers.forEach(teacher=> { %>
                                                        <tr>
                                                            <td>
                                                                <%= teacher.username %>
                                                            </td>
                                                            <td>
                                                                <%= (teacherCoursesMap && teacherCoursesMap[teacher.id]
                                                                    && teacherCoursesMap[teacher.id].length> 0) ?
                                                                    teacherCoursesMap[teacher.id].join(', ') : '-' %>
                                                            </td>
                                                            <td>Pending Setup</td>
                                                            <td>
                                                                <div style="display: flex; gap: 8px;">
                                                                    <button type="button" class="btn"
                                                                        style="background: var(--surface); color: var(--primary); border: 1px solid var(--border);"
                                                                        onclick="openEditModal('<%= teacher.id %>', '<%= teacher.username %>')">Edit</button>
                                                                    <form action="/admin/delete-user" method="POST"
                                                                        onsubmit="return confirm('Are you sure you want to remove this teacher?');"
                                                                        style="margin: 0;">
                                                                        <input type="hidden" name="user_id"
                                                                            value="<%= teacher.id %>">
                                                                        <button type="submit"
                                                                            class="btn btn-danger">Remove</button>
                                                                    </form>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                        </tbody>
                                    </table>
                                    <% } else { %>
                                        <div class="alert alert-empty">No active teachers found.</div>
                                        <% } %>
                            </div>
                        </div>

                        <div class="col-12" id="tab_requests" style="display:none;">
                            <div class="card">
                                <h3 class="card-title">Password Reset Requests</h3>
                                <p class="card-text" style="font-size: 14px; opacity: 0.8; margin-bottom: 16px;">
                                    Approving a request will set the user's password to <code>defaultpassword123</code>
                                    and force them to change it upon their next login.
                                </p>
                                <% if (pwdRequests && pwdRequests.length> 0) { %>
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>User</th>
                                                <th>Role</th>
                                                <th>Date Requested</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% pwdRequests.forEach(req=> { %>
                                                <tr>
                                                    <td>
                                                        <%= req.username %>
                                                    </td>
                                                    <td style="text-transform: capitalize;">
                                                        <%= req.requested_by_role.replace('_', ' ' ) %>
                                                    </td>
                                                    <td>
                                                        <%= new Date(req.created_at).toLocaleDateString() %>
                                                    </td>
                                                    <td>
                                                        <div style="display: flex; gap: 8px;">
                                                            <form action="/admin/approve-password-reset" method="POST"
                                                                onsubmit="return confirm('Approve reset for <%= req.username %>?');"
                                                                style="margin: 0;">
                                                                <input type="hidden" name="request_id"
                                                                    value="<%= req.id %>">
                                                                <input type="hidden" name="user_id"
                                                                    value="<%= req.user_id %>">
                                                                <button type="submit" class="btn btn-success"
                                                                    style="padding: 4px 10px; font-size: 13px;">Approve</button>
                                                            </form>

                                                            <form action="/admin/reject-password-reset" method="POST"
                                                                onsubmit="return confirm('Reject reset request for <%= req.username %>?');"
                                                                style="margin: 0;">
                                                                <input type="hidden" name="request_id"
                                                                    value="<%= req.id %>">
                                                                <button type="submit" class="btn btn-danger"
                                                                    style="padding: 4px 10px; font-size: 13px;">Reject</button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                    <% } else { %>
                                        <div class="alert alert-empty">No pending password reset requests.</div>
                                        <% } %>
                            </div>
                        </div>
            </div>

            <!-- Edit User Modal -->
            <div id="editModal"
                style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
                <div class="card" style="width: 100%; max-width: 400px; position: relative;">
                    <h3 class="card-title">Edit Username</h3>
                    <form action="/admin/edit-user" method="POST" class="stack" style="margin-top: 16px;">
                        <input type="hidden" name="user_id" id="edit_user_id">
                        <input class="field" type="text" name="new_username" id="edit_username" required>
                        <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 16px;">
                            <button type="button" class="btn btn-secondary"
                                onclick="document.getElementById('editModal').style.display='none'">Cancel</button>
                            <button type="submit" class="btn">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>

            <script>
                function openEditModal(id, username) {
                    document.getElementById('edit_user_id').value = id;
                    document.getElementById('edit_username').value = username;
                    document.getElementById('editModal').style.display = 'flex';
                }

                function showTab(tab) {
                    const students = document.getElementById('tab_students');
                    const teachers = document.getElementById('tab_teachers');
                    const requests = document.getElementById('tab_requests');

                    const btnStudents = document.getElementById('btn_tab_students');
                    const btnTeachers = document.getElementById('btn_tab_teachers');
                    const btnRequests = document.getElementById('btn_tab_requests');

                    if (!students || !teachers || !requests) return;

                    students.style.display = 'none';
                    teachers.style.display = 'none';
                    requests.style.display = 'none';

                    btnStudents.className = 'btn btn-secondary';
                    btnTeachers.className = 'btn btn-secondary';
                    btnRequests.className = 'btn btn-secondary';

                    if (tab === 'teachers') {
                        teachers.style.display = '';
                        btnTeachers.className = 'btn';
                    } else if (tab === 'requests') {
                        requests.style.display = '';
                        btnRequests.className = 'btn';
                    } else {
                        students.style.display = '';
                        btnStudents.className = 'btn';
                    }
                }

                (function () {
                    try {
                        const params = new URLSearchParams(window.location.search);
                        const tab = params.get('tab');
                        if (tab === 'teachers') showTab('teachers');
                        else if (tab === 'requests') showTab('requests');
                        else showTab('students');
                    } catch (e) {
                    }
                })();
            </script>
        </div>
    </div>

</body>

</html>