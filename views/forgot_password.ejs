<!DOCTYPE html>
<html>

<head>
    <title>SecureExam Pro - Forgot Password</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="auth-shell">
        <div class="card auth-card">
            <div class="auth-icon" aria-hidden="true" style="color: #e67e22; background: rgba(230, 126, 34, 0.12);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path
                        d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4">
                    </path>
                </svg>
            </div>

            <h1 class="page-title" style="margin-top: 0;">Password Recovery</h1>
            <p class="page-subtitle" style="margin-bottom: 0;">Submit a request to reset your password</p>

            <div style="text-align: left; margin-top: 24px;">
                <% if (typeof success !=='undefined' && success) { %>
                    <div
                        style="background: rgba(39, 174, 96, 0.12); color: #27ae60; padding: 12px; border-radius: 8px; margin-bottom: 16px; font-weight: 500;">
                        Password reset request sent successfully.
                    </div>
                    <% } else if (typeof error !=='undefined' && error==='user_not_found' ) { %>
                        <div
                            style="background: rgba(235, 87, 87, 0.12); color: #eb5757; padding: 12px; border-radius: 8px; margin-bottom: 16px; font-weight: 500;">
                            User not found. Please try again.
                        </div>
                        <% } else if (typeof error !=='undefined' && error==='already_pending' ) { %>
                            <div
                                style="background: rgba(230, 126, 34, 0.12); color: #e67e22; padding: 12px; border-radius: 8px; margin-bottom: 16px; font-weight: 500;">
                                A password reset request is already pending for this account.
                            </div>
                            <% } %>

                                <div style="opacity: 0.9; margin-bottom: 14px;">Please enter your username. A reset
                                    request will be sent
                                    to the administrator for approval.</div>

                                <form action="/forgot-password" method="POST" class="stack">
                                    <div class="input-icon">
                                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path
                                                d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6Z"
                                                stroke="currentColor" stroke-width="1.8" />
                                            <path d="m4.5 7.5 7 5a2 2 0 0 0 2.3 0l7-5" stroke="currentColor"
                                                stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                        <input class="field" type="text" name="username"
                                            placeholder="Institutional Email / Username" required>
                                    </div>

                                    <button class="btn" type="submit"
                                        style="width: 100%; border-radius: 999px; padding: 12px 14px; background: #e67e22;">Submit
                                        Request</button>
                                </form>

                                <div style="margin-top: 16px; text-align: center;">
                                    <a href="/" class="btn btn-ghost" style="padding: 6px 10px; font-size: 13px;">Back
                                        to Login</a>
                                </div>
            </div>
        </div>
    </div>
</body>

</html>