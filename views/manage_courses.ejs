<!DOCTYPE html>
<html>

<head>
    <title>Manage Courses</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="app-shell">
        <div class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="/admin">Secure Exam</a>
                <div class="nav-group">
                    <a class="btn btn-ghost" href="/admin">Dashboard</a>
                    <a class="btn btn-danger" href="/logout">Logout</a>
                </div>
            </div>
        </div>

        <div class="container">
            <h1 class="page-title">Manage Courses</h1>
            <p class="page-subtitle">Create courses, manage levels, and assign teachers.</p>

            <div class="grid">
                <div class="col-6">
                    <div class="card">
                        <h3 class="card-title">Add New Course</h3>
                        <form action="/admin/add-course" method="POST" class="stack">
                            <div>
                                <label><strong>Course Name</strong></label>
                                <input class="field" type="text" name="course_name" required>
                            </div>
                            <div>
                                <label><strong>Number of Levels</strong></label>
                                <input class="field" type="number" name="levels" min="1" value="1" required>
                            </div>
                            <button type="submit" class="btn" style="width: fit-content;">Add Course</button>
                        </form>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card">
                        <h3 class="card-title">Existing Courses</h3>
                        <% if (courses && courses.length> 0) { %>
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Course Name</th>
                                        <th>Levels</th>
                                        <th>Assigned Teachers</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% courses.forEach(course=> { %>
                                        <tr>
                                            <td><%= course.id %></td>
                                            <td>
                                                <a href="/course/<%= course.id %>/manage" style="text-decoration:none; color: inherit; font-weight: 700;">
                                                    <%= course.course_name %>
                                                </a>
                                            </td>
                                            <td><%= course.levels %></td>
                                            <td><%= course.teachers ? course.teachers : 'None' %></td>
                                            <td>
                                                <form action="/admin/delete-course" method="POST"
                                                    onsubmit="return confirm('Are you sure you want to delete this course? All questions, results, and teacher assignments related to it will also be deleted.');">
                                                    <input type="hidden" name="course_id" value="<%= course.id %>">
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        <% } else { %>
                            <div style="opacity: 0.8;">No courses available right now.</div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div style="margin-top: 16px;">
                <a href="/admin" class="btn btn-secondary">Back to Dashboard</a>
            </div>
        </div>
    </div>
</body>

</html>