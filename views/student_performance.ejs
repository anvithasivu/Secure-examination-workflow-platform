<!DOCTYPE html>
<html>

<head>
    <title>Your Performance</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #e6e6fa;
            color: #4a235a;
            padding: 20px;
        }

        h1 {
            color: #716499;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background-color: #fdfefe;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(100, 80, 150, 0.1);
        }

        th,
        td {
            padding: 12px;
            border: 1px solid #c9b1de;
            text-align: left;
        }

        th {
            background-color: #b8c0ff;
            color: #4a235a;
        }

        tr:nth-child(even) {
            background-color: #f7f1fa;
        }

        .pass {
            color: #27ae60;
            font-weight: bold;
        }

        .fail {
            color: #e74c3c;
            font-weight: bold;
        }

        .back-btn {
            display: inline-block;
            margin-top: 20px;
            padding: 10px 15px;
            background-color: #b8c0ff;
            color: #4a235a;
            font-weight: bold;
            border-radius: 6px;
            text-decoration: none;
            transition: 0.3s;
        }

        .back-btn:hover {
            background-color: #9ba7f5;
            color: #fff;
        }
    </style>
</head>

<body>
    <h1>Your Performance</h1>

    <table>
        <thead>
            <tr>
                <th>Course</th>
                <th>Level</th>
                <th>Score</th>
                <th>Attempts</th>
                <th>Result</th>
            </tr>
        </thead>
        <tbody>
            <% if (results.length===0) { %>
                <tr>
                    <td colspan="5" style="text-align: center;">No results found.</td>
                </tr>
                <% } else { %>
                    <% results.forEach(r=> { %>
                        <tr>
                            <td>
                                <%= r.course_name %>
                            </td>
                            <td>Level <%= r.level %>
                            </td>
                            <td>
                                <%= r.score %> / 100
                            </td>
                            <td>
                                <%= r.attempts %>
                            </td>
                            <td class="<%= r.score >= 60 ? 'pass' : 'fail' %>">
                                <%= r.score>= 60 ? 'Cleared' : 'Not Cleared' %>
                            </td>
                        </tr>
                        <% }) %>
                            <% } %>
        </tbody>
    </table>

    <a href="/student-dashboard" class="back-btn">Back to Dashboard</a>
</body>

</html>