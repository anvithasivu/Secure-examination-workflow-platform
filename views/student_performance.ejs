<!DOCTYPE html>
<html>

<head>
    <title>Your Performance</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="app-shell">
        <div class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="/student-dashboard">Secure Exam</a>
                <div class="nav-group">
                    <a class="btn btn-ghost" href="/student-dashboard">Dashboard</a>
                    <a class="btn btn-danger" href="/logout">Logout</a>
                </div>
            </div>
        </div>

        <div class="container">
            <h1 class="page-title">Your Performance</h1>
            <p class="page-subtitle">Review your scores and attempts by course and level.</p>

            <div class="card">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Level</th>
                            <th>Score</th>
                            <th>Attempts</th>
                            <th>Result</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (results.length===0) { %>
                            <tr>
                                <td colspan="5" style="text-align: center;">No results found.</td>
                            </tr>
                            <% } else { %>
                                <% results.forEach(r=> { %>
                                    <tr>
                                        <td>
                                            <%= r.course_name %>
                                        </td>
                                        <td>Level <%= r.level %>
                                        </td>
                                        <td>
                                            <%= r.score %> / 100
                                        </td>
                                        <td>
                                            <%= r.attempts %>
                                        </td>
                                        <td class="<%= r.score >= 60 ? 'text-pass' : 'text-fail' %>" style="font-weight: 800;">
                                            <%= r.score>= 60 ? 'Cleared' : 'Not Cleared' %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                <% } %>
                    </tbody>
                </table>
            </div>

            <div style="margin-top: 16px;">
                <a href="/student-dashboard" class="btn btn-secondary">Back to Dashboard</a>
            </div>
        </div>
    </div>
</body>

</html>