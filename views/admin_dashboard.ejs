<!DOCTYPE html>
<html>

<head>
    <title>Admin Dashboard</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #e6e6fa;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding-top: 60px;
            color: #4a235a;
        }

        header {
            width: 100%;
            position: fixed;
            top: 0;
            left: 0;
            height: 50px;
            background-color: #e8daef;
            box-shadow: 0 2px 10px rgba(100, 80, 150, 0.2);
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding-right: 30px;
            z-index: 1000;
        }

        header a {
            text-decoration: none;
            color: #716499;
            font-weight: bold;
            padding: 8px 16px;
            border-radius: 5px;
            transition: background-color 0.3s;
        }

        header a:hover {
            background-color: #9ba7f5;
            color: #fff;
        }

        h1 {
            margin-top: 20px;
            color: #716499;
        }

        .dashboard {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            margin-top: 50px;
            gap: 30px;
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
        }

        .card {
            background-color: #fdfefe;
            border-radius: 12px;
            width: 200px;
            height: 120px;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            font-size: 18px;
            color: #4a235a;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
            transition: 0.3s;
            box-shadow: 0 5px 15px rgba(100, 80, 150, 0.1);
        }

        .card:hover {
            transform: translateY(-5px);
            background-color: #b8c0ff;
            box-shadow: 0 10px 20px rgba(100, 80, 150, 0.2);
            color: #fff;
        }

        .add-question {
            background-color: #fdfefe;
        }

        .view-questions {
            background-color: #fdfefe;
        }

        .view-results {
            background-color: #fdfefe;
        }

        .manage-courses {
            background-color: #fdfefe;
        }
    </style>
</head>

<body>

    <header>
        <a href="/logout">Logout</a>
    </header>

    <h1>Welcome, Admin</h1>

    <div class="dashboard">
        <a href="/admin/manage-courses" class="card manage-courses">Manage Courses</a>
        <a href="/admin/manage-users" class="card view-results" style="background-color: #fdfefe;">Manage Users</a>
        <a href="/view-results" class="card view-results">View All Results</a>
    </div>

</body>

</html>