<!DOCTYPE html>
<html>

<head>
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="app-shell">
        <div class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="/admin">Secure Exam</a>
                <div class="nav-group">
                    <a class="btn btn-ghost" href="/admin">Dashboard</a>
                    <a class="btn btn-danger" href="/logout">Logout</a>
                </div>
            </div>
        </div>

        <div class="container">
            <h1 class="page-title">Admin Dashboard</h1>
            <p class="page-subtitle">Manage courses, users, and results from one place.</p>

            <div class="grid">
                <div class="col-12">
                    <div class="card">
                        <h3 class="card-title">Administration</h3>
                        <div class="card-actions">
                            <a href="/admin/manage-courses" class="btn">Manage Courses</a>
                            <a href="/admin/manage-users" class="btn">Manage Users</a>
                            <a href="/view-results" class="btn btn-secondary">View All Results</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>