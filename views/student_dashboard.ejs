<!DOCTYPE html>
<html>
<head>
  <title>Student Dashboard</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f3f6f9;
      margin: 0;
      padding: 0;
    }

    header {
      background-color: #ffffff;
      padding: 15px 30px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    header h1 {
      margin: 0;
      font-size: 22px;
      color: #333;
    }

    header a {
      text-decoration: none;
      color: #007BFF;
      font-weight: bold;
    }

    main {
      padding: 30px;
    }

    .courses-container {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 20px;
    }

    .course-card {
      background-color: #fff;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      overflow: hidden;
      text-decoration: none;
      color: #333;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .course-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .course-image {
      width: 100%;
      height: 140px;
      object-fit: cover;
    }

    .course-content {
      padding: 15px;
    }

    .course-title {
      font-weight: bold;
      font-size: 18px;
      margin-bottom: 8px;
    }

    .course-info {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
      color: #555;
      margin-bottom: 10px;
    }

    .progress-container {
      background-color: #e6e6e6;
      border-radius: 5px;
      height: 8px;
      width: 100%;
      overflow: hidden;
    }

    .progress-bar {
      background-color: #4CAF50;
      height: 100%;
      width: 0%; /* default 0% */
    }

    .progress-text {
      margin-top: 5px;
      font-size: 12px;
      color: #555;
      text-align: center;
    }
  </style>
</head>
<body>

  <header>
    <h1>Welcome, <%= user.username %></h1>
    <a href="/logout">Logout</a>
  </header>

  <main>
    <h2>Select a Course</h2>
    <div class="courses-container">
      <% courses.forEach(c => { %>
        <a href="/student-levels/<%= c.id %>" class="course-card">
          <img src="https://via.placeholder.com/300x140?text=<%= encodeURIComponent(c.course_name) %>" alt="<%= c.course_name %>" class="course-image">
          <div class="course-content">
            <div class="course-title"><%= c.course_name %></div>
            <div class="course-info">
              <span>Levels: <%= c.levels %></span>
              <span>GENERAL</span> <!-- placeholder for category -->
            </div>
            <div class="progress-container">
              <div class="progress-bar" style="width: 0%"></div> <!-- progress placeholder -->
            </div>
            <div class="progress-text">Progress: 0/<%= c.levels %> (0%)</div>
          </div>
        </a>
      <% }) %>
    </div>
  </main>

</body>
</html>
