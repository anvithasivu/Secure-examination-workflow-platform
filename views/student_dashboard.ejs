<!DOCTYPE html>
<html>
<head>
  <title>Student Dashboard</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f0f4f8; margin: 20px; }
    h1 { color: #333; }
    .course-card {
      display: inline-block; width: 220px; margin: 10px; padding: 15px; background: #fff;
      border-radius: 8px; box-shadow: 2px 2px 5px #aaa; text-align: center; text-decoration: none; color: black;
    }
    .course-card:hover { background: #e0f7fa; }
    .course-title { font-weight: bold; font-size: 18px; margin-bottom: 8px; }
    .course-levels { font-size: 14px; color: #555; }
    .logout { float: right; background: #dc3545; color: white; padding: 8px 15px; text-decoration: none; border-radius: 5px; }
    .logout:hover { background: #b52a37; }
  </style>
</head>
<body>
  <a href="/logout" class="logout">Logout</a>
  <h1>Welcome, <%= user.username %></h1>
  <h2>Select a Course</h2>

  <div>
    <% courses.forEach(c => { %>
      <a href="/student-levels/<%= c.id %>" class="course-card">
        <div class="course-title"><%= c.course_name %></div>
        <div class="course-levels">Levels: <%= c.levels %></div>
      </a>
    <% }) %>
  </div>
</body>
</html>
