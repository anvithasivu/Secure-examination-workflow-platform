<!DOCTYPE html>
<html>
<head>
  <title>Exam</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    h1 { color: #333; }
    .question { margin-bottom: 20px; padding: 15px; border-radius: 8px; background: #f9f9f9; border: 1px solid #ccc; }
    h3 { margin-bottom: 10px; }
    input[type="radio"] { margin-right: 8px; }
    textarea { width: 100%; height: 100px; margin-top: 5px; }
    button { margin-top: 15px; padding: 10px 20px; background: #007BFF; color: white; border: none; border-radius: 5px; cursor: pointer; }
    button:hover { background: #0056b3; }
  </style>
</head>
<body>
  <h1>Course: <%= courseId %> | Level: <%= level %></h1>

  <form method="POST" action="/submit-exam/<%= courseId %>/<%= level %>">
    <% mcqQuestions.forEach((q, index) => { %>
      <div class="question">
        <h3>Q<%= index+1 %>: <%= q.question %></h3>
        <label><input type="radio" name="mcq_<%= q.id %>" value="1"> <%= q.option1 %></label><br>
        <label><input type="radio" name="mcq_<%= q.id %>" value="2"> <%= q.option2 %></label><br>
        <label><input type="radio" name="mcq_<%= q.id %>" value="3"> <%= q.option3 %></label><br>
        <label><input type="radio" name="mcq_<%= q.id %>" value="4"> <%= q.option4 %></label>
      </div>
    <% }) %>

    <% codingQuestions.forEach((q, index) => { %>
      <div class="question">
        <h3>Coding Q<%= index+1 %>: <%= q.coding_question %></h3>
        <textarea name="coding_<%= q.id %>" placeholder="Write your code here..."><%= q.starter_code %></textarea>
      </div>
    <% }) %>

    <button type="submit">Submit Exam</button>
  </form>
</body>
</html>
