<!DOCTYPE html>
<html>

<head>
  <title>Teacher Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <div class="app-shell">
    <div class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/teacher-dashboard">Secure Exam</a>
        <div class="nav-group">
          <a class="btn btn-ghost" href="/teacher-dashboard">Dashboard</a>
          <a class="btn btn-danger" href="/logout">Logout</a>
        </div>
      </div>
    </div>

    <div class="container">
      <h1 class="page-title">Teacher Dashboard</h1>
      <p class="page-subtitle">Create MCQs, manage course levels, and review results.</p>

      <div class="grid">
        <div class="col-12">
          <div class="card">
            <h3 class="card-title">Your Courses</h3>
            <div class="grid">
              <% courses.forEach(c=> { %>
                <div class="col-4">
                  <div class="card">
                    <h4 class="card-title"><%= c.course_name %></h4>
                    <div class="card-actions">
                      <a class="btn" href="/course/<%= c.id %>/manage">Manage</a>
                      <a class="btn btn-secondary" href="/view-results?course_id=<%= c.id %>">Results</a>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>

</html>