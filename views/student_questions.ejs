<!DOCTYPE html>
<html>

<head>
  <title>Exam - Level <%= level %> (Course: <%= course.course_name %>)</title>
  <style>
    body {
      font-family: 'Arial', sans-serif;
      margin: 20px;
      background-color: #e6e6fa;
      color: #4a235a;
    }

    h1,
    h2 {
      margin-top: 20px;
      color: #716499;
    }

    .question-box {
      background-color: #fdfefe;
      padding: 15px;
      margin-bottom: 20px;
      border-radius: 12px;
      box-shadow: 0 5px 15px rgba(100, 80, 150, 0.1);
    }

    input[type="text"],
    textarea,
    select {
      width: 100%;
      padding: 10px;
      margin-top: 8px;
      border-radius: 6px;
      border: 1px solid #c9b1de;
      background-color: #fdfefe;
      color: #4a235a;
      outline: none;
    }

    button {
      padding: 12px 20px;
      border: none;
      border-radius: 6px;
      background-color: #b8c0ff;
      color: #4a235a;
      font-weight: bold;
      cursor: pointer;
      margin-top: 15px;
      font-size: 16px;
      transition: 0.3s;
    }

    button:hover {
      background-color: #9ba7f5;
      color: #fff;
    }

    .back {
      display: inline-block;
      margin-top: 20px;
      padding: 10px 15px;
      background-color: #ffc4d9;
      color: #4a235a;
      font-weight: bold;
      border-radius: 6px;
      text-decoration: none;
      transition: 0.3s;
    }

    .back:hover {
      background-color: #ff99b9;
    }
  </style>
</head>

<body>
  <h1>Exam - Level <%= level %> (Course: <%= course.course_name %>)</h1>

  <form action="/submit-exam" method="POST">
    <input type="hidden" name="course_id" value="<%= course.id %>">
    <input type="hidden" name="level" value="<%= level %>">

    <h2>MCQ Questions</h2>
    <% mcqQuestions.forEach((q, index)=> { %>
      <div class="question-box">
        <p><strong>Q<%= index+1 %>:</strong>
          <%= q.question %>
        </p>
        <input type="text" name="mcq_<%= q.id %>" placeholder="Type your answer here">
      </div>
      <% }) %>

        <h2>Coding Questions</h2>
        <% codingQuestions.forEach((q, index)=> { %>
          <div class="question-box">
            <p><strong>Q<%= index+1 %>:</strong>
              <%= q.coding_question %>
            </p>

            <label>Programming Language:</label>
            <select name="lang_<%= q.id %>" required style="margin-bottom: 10px; width: auto;">
              <option value="python">Python</option>
              <option value="javascript">JavaScript (Node.js)</option>
              <option value="java">Java</option>
              <option value="c++">C++</option>
              <option value="c">C</option>
            </select>

            <textarea name="coding_<%= q.id %>" rows="10" style="font-family: monospace; width: 100%;"
              placeholder="Write your code here..."><%= q.starter_code ? q.starter_code : '' %></textarea>
          </div>
          <% }) %>

            <button type="submit">Submit Exam</button>
  </form>

  <a href="/student-levels/<%= course.id %>" class="back">Back to Levels</a>
</body>

</html>