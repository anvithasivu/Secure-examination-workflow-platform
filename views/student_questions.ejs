<!DOCTYPE html>
<html>

<head>
  <title>Exam - Level <%= level %> (Course: <%= course.course_name %>)</title>
  <link rel="stylesheet" href="/style.css">
  <script>
    let timeLeft = 600; // 10 minutes in seconds
    function updateTimer() {
      const minutes = Math.floor(timeLeft / 60);
      const seconds = timeLeft % 60;
      document.getElementById('timer').innerText = `Time Left: ${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
      if (timeLeft <= 0) {
        document.getElementById('examForm').submit();
      } else {
        timeLeft--;
        setTimeout(updateTimer, 1000);
      }
    }
    window.onload = updateTimer;
  </script>
</head>

<body>
  <div class="app-shell">
    <div class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/student-dashboard">Secure Exam</a>
        <div class="nav-group">
          <a class="btn btn-ghost" href="/student-levels/<%= course.id %>">Levels</a>
          <a class="btn btn-danger" href="/logout">Logout</a>
        </div>
      </div>
    </div>

    <div class="container">
      <div style="display:flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap;">
        <div>
          <h1 class="page-title"><%= course.course_name %> - <%= "Level " + level %></h1>
          <p class="page-subtitle">Timed MCQ assessment. Negative marking applies.</p>
        </div>
        <div class="card" style="padding: 12px 14px;">
          <div id="timer" style="font-weight: 800;">Time Left: 10:00</div>
        </div>
      </div>

      <form id="examForm" action="/submit-exam" method="POST">
        <input type="hidden" name="course_id" value="<%= course.id %>">
        <input type="hidden" name="level" value="<%= level %>">

        <div class="stack">
          <% mcqQuestions.forEach((q, index)=> { %>
            <div class="card">
              <h3 class="card-title">Q<%= index+1 %></h3>
              <div style="margin-bottom: 10px;"><%= q.question %></div>
              <div class="stack" style="gap: 8px;">
                <label><input type="radio" name="mcq_<%= q.id %>" value="1"> <%= q.option1 %></label>
                <label><input type="radio" name="mcq_<%= q.id %>" value="2"> <%= q.option2 %></label>
                <label><input type="radio" name="mcq_<%= q.id %>" value="3"> <%= q.option3 %></label>
                <label><input type="radio" name="mcq_<%= q.id %>" value="4"> <%= q.option4 %></label>
              </div>
            </div>
          <% }) %>
        </div>

        <div style="margin-top: 16px;" class="row">
          <a href="/student-levels/<%= course.id %>" class="btn btn-secondary">Back to Levels</a>
          <button type="submit" class="btn">Submit Exam</button>
        </div>
      </form>
    </div>
  </div>
</body>

</html>