<!DOCTYPE html>
<html>

<head>
    <title>Sign Up</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="app-shell">
        <div class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="/">Secure Exam</a>
            </div>
        </div>

        <div class="container">
            <div class="grid">
                <div class="col-12">
                    <div class="card" style="max-width: 420px; margin: 24px auto;">
                        <h1 class="page-title" style="text-align:center;">Create Account</h1>
                        <p class="page-subtitle" style="text-align:center;">Register as a student to take exams.</p>

                        <form action="/signup" method="POST" class="stack">
                            <input class="field" type="text" name="username" placeholder="Username" required>
                            <input class="field" type="password" name="password" placeholder="Password" required>
                            <button class="btn" type="submit" style="width:100%;">Register</button>
                        </form>

                        <div style="margin-top: 12px; text-align:center;">
                            <a href="/" class="btn btn-ghost">Already have an account? Login</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>