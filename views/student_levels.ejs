<!DOCTYPE html>
<html>
<head>
  <title><%= course.course_name %> Levels</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f9f9f9; margin: 20px; }
    h1 { color: #333; }
    ul.level-list { list-style: none; padding: 0; display: flex; flex-wrap: wrap; }
    ul.level-list li {
      background: white;
      margin: 10px;
      padding: 15px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      text-align: center;
      width: 180px;
    }
    a.take-exam { display: inline-block; margin-top: 10px; padding: 6px 12px; background: #007BFF; color: white; border-radius: 5px; text-decoration: none; }
    a.take-exam:hover { background: #0056b3; }
    a.back { display: block; margin-top: 20px; text-decoration: none; font-weight: bold; color: #dc3545; }
  </style>
</head>
<body>
  <h1><%= course.course_name %> Levels</h1>

  <ul class="level-list">
    <% for(let i = 1; i <= levels; i++) { %>
      <li>
        Level <%= i %> - <%= levelTopics[i] || "No topic assigned" %>
        <br>
        <a href="/exam/<%= course.id %>/<%= i %>" class="take-exam">Take Exam</a>
      </li>
    <% } %>
  </ul>

  <a href="/student-courses" class="back">Back to Courses</a>
</body>
</html>
