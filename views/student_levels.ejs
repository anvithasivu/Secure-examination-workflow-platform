<!DOCTYPE html>
<html>

<head>
  <title>Levels - <%= course.course_name %>
  </title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <div class="app-shell">
    <div class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/student-dashboard">Secure Exam</a>
        <div class="nav-group">
          <a class="btn btn-ghost" href="/student-dashboard">Dashboard</a>
          <a class="btn btn-danger" href="/logout">Logout</a>
        </div>
      </div>
    </div>

    <div class="container">
      <h1 class="page-title"><%= course.course_name %></h1>
      <p class="page-subtitle">Select a level to begin the timed MCQ assessment.</p>

      <div class="grid">
        <% levels.forEach(level=> {
          let i = level.level_number;
          let attemptInfo = attemptsMap[i] || 0;
          let isCleared = (clearedMap && clearedMap[i]) ? true : false;
          let isUnlocked = i <= maxUnlocked; %>

          <% if (isCleared) { %>
            <div class="col-3">
              <div class="card" style="border: 1px solid rgba(39, 174, 96, 0.4);">
                <h3 class="card-title"><%= level.level_name %></h3>
                <div style="display:flex; justify-content: space-between; gap: 10px; flex-wrap: wrap;">
                  <div>Level <%= i %></div>
                  <div class="text-pass" style="font-weight: 800;">Cleared</div>
                </div>
                <div style="margin-top: 10px; opacity: 0.85;">Attempts: <%= attemptInfo %></div>
                <div style="margin-top: 12px;">
                  <span class="btn btn-ghost" style="pointer-events:none; opacity: 0.7;">Completed</span>
                </div>
              </div>
            </div>
          <% } else if (isUnlocked) { %>
            <div class="col-3">
              <a href="/exam/<%= course.id %>/<%= i %>" class="card" style="display:block; text-decoration:none; color:inherit;">
                <h3 class="card-title"><%= level.level_name %></h3>
                <div style="display:flex; justify-content: space-between; gap: 10px; flex-wrap: wrap;">
                  <div>Level <%= i %></div>
                  <div style="font-weight: 800; opacity: 0.8;">Unlocked</div>
                </div>
                <div style="margin-top: 10px; opacity: 0.85;">Attempts: <%= attemptInfo %></div>
                <div style="margin-top: 12px;">
                  <span class="btn btn-ghost" style="pointer-events:none;">Start</span>
                </div>
              </a>
            </div>
          <% } else { %>
            <div class="col-3">
              <div class="card" style="opacity: 0.7; background: #f7f1fa;">
                <h3 class="card-title"><%= level.level_name %></h3>
                <div style="display:flex; justify-content: space-between; gap: 10px; flex-wrap: wrap;">
                  <div>Level <%= i %></div>
                  <div style="font-weight: 800; opacity: 0.8;">Locked</div>
                </div>
                <div style="margin-top: 10px; opacity: 0.85;">Attempts: <%= attemptInfo %></div>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
    </div>
  </div>
</body>

</html>