<!DOCTYPE html>
<html>
<head>
  <title>Student Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="app-shell">
    <div class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/student-dashboard">Secure Exam</a>
        <div class="nav-group">
          <a class="btn btn-ghost" href="/student-dashboard">Dashboard</a>
          <a class="btn btn-danger" href="/logout">Logout</a>
        </div>
      </div>
    </div>

    <div class="container">
      <h1 class="page-title">Welcome, <%= user.username %></h1>
      <p class="page-subtitle">Choose a course to view levels and start your next exam.</p>

      <div class="grid">
        <% courses.forEach(c => { %>
          <div class="col-4">
            <div class="card">
              <div class="card-header">
                <div>
                  <div style="font-weight: 900;"><%= c.course_name %></div>
                  <div style="opacity: 0.8; margin-top: 4px;">Levels: <%= c.levels %></div>
                </div>
                <div class="card-actions">
                  <a href="/student-levels/<%= c.id %>" class="btn">View Levels</a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</body>
</html>
