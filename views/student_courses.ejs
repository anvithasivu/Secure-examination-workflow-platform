<!DOCTYPE html>
<html>
<head>
  <title>Student Dashboard</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    .course-card {
      border: 1px solid #ccc;
      padding: 15px;
      margin: 10px;
      display: inline-block;
      width: 220px;
      text-align: center;
      border-radius: 8px;
      box-shadow: 2px 2px 5px #aaa;
      text-decoration: none;
      color: black;
      background-color: #f9f9f9;
    }
    .course-card:hover { background-color: #e0f7fa; }
    .course-title { font-weight: bold; font-size: 16px; margin-bottom: 8px; }
    .course-levels { font-size: 14px; color: #555; }
    a.logout { display: block; margin-top: 20px; color: red; text-decoration: none; }
  </style>
</head>
<body>
  <h1>Welcome, <%= user.username %></h1>
  <h2>Select a Course</h2>

  <div>
    <% courses.forEach(c => { %>
      <a href="/student-levels/<%= c.id %>" class="course-card">
        <div class="course-title"><%= c.course_name %></div>
        <div class="course-levels">Levels: <%= c.levels %></div>
      </a>
    <% }) %>
  </div>

  <a href="/logout" class="logout">Logout</a>
</body>
</html>
