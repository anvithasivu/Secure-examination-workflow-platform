<!DOCTYPE html>
<html>
<head>
  <title>Exam</title>
</head>
<body>
  <h1>Exam</h1>
  <form method="POST" action="/submit-exam/<%= courseId %>">
    <% questions.forEach((q, index) => { %>
      <% if(q.question && q.question.trim() !== "") { %>
        <p><strong><%= index+1 %>. <%= q.question %></strong></p>
        <input type="radio" name="<%= q.id %>" value="1"> <%= q.option1 %><br>
        <input type="radio" name="<%= q.id %>" value="2"> <%= q.option2 %><br>
        <input type="radio" name="<%= q.id %>" value="3"> <%= q.option3 %><br>
        <input type="radio" name="<%= q.id %>" value="4"> <%= q.option4 %><br><br>
      <% } %>

      <% if(q.coding_question && q.coding_question.trim() !== "") { %>
        <p><strong>Coding: <%= q.coding_question %></strong></p>
        <textarea name="<%= q.id %>" rows="5" cols="60" placeholder="Write your code here"></textarea><br><br>
      <% } %>
    <% }) %>

    <button type="submit">Submit Exam</button>
  </form>

  <br>
  <a href="/student">Back to Courses</a>
</body>
</html>
