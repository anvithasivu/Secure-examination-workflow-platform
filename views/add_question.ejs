<!DOCTYPE html>
<html>

<head>
  <title>Add Question</title>
  <script>
    function toggleFields() {
      const type = document.getElementById("question_type").value;
      document.getElementById("mcq_fields").style.display = (type === 'mcq') ? 'block' : 'none';
      document.getElementById("coding_fields").style.display = (type === 'coding') ? 'block' : 'none';
    }
  </script>
  <style>
    body {
      font-family: 'Arial', sans-serif;
      background-color: #e6e6fa;
      color: #4a235a;
      padding: 20px;
    }

    h1,
    h4 {
      color: #716499;
    }

    label {
      font-weight: bold;
      color: #716499;
    }

    input,
    select,
    textarea {
      width: 100%;
      margin: 5px 0 15px 0;
      padding: 12px;
      border-radius: 6px;
      border: 1px solid #c9b1de;
      background-color: #fdfefe;
      color: #4a235a;
      outline: none;
      box-sizing: border-box;
    }

    button {
      background-color: #b8c0ff;
      color: #4a235a;
      border: none;
      padding: 12px 20px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 16px;
      font-weight: bold;
      transition: 0.3s;
      width: 100%;
    }

    button:hover {
      background-color: #9ba7f5;
      color: #fff;
    }

    a {
      display: inline-block;
      margin-top: 15px;
      text-decoration: none;
      color: #716499;
      font-weight: bold;
    }

    a:hover {
      text-decoration: underline;
    }
  </style>
</head>

<body>
  <h1>Add Question</h1>

  <form action="/add-question" method="POST">
    <label>Course:</label>
    <select name="course_id" required>
      <% courses.forEach(c=> { %>
        <option value="<%= c.id %>">
          <%= c.course_name %>
        </option>
        <% }) %>
    </select>

    <label>Level:</label>
    <select name="level" required>
      <% for(let i=1; i<=10; i++) { %>
        <option value="<%= i %>">Level <%= i %>
        </option>
        <% } %>
    </select>

    <label>Question Type:</label>
    <select id="question_type" name="question_type" onchange="toggleFields()" required>
      <option value="">--Select--</option>
      <option value="mcq">MCQ</option>
      <option value="coding">Coding</option>
    </select>

    <div id="mcq_fields" style="display:none;">
      <label>Question:</label><textarea name="question"></textarea>
      <input type="text" name="option1" placeholder="Option 1">
      <input type="text" name="option2" placeholder="Option 2">
      <input type="text" name="option3" placeholder="Option 3">
      <input type="text" name="option4" placeholder="Option 4">
      <input type="number" name="correct" min="1" max="4" placeholder="Correct Option">
    </div>

    <div id="coding_fields" style="display:none;">
      <label>Coding Question:</label><textarea name="coding_question"></textarea>
      <label>Starter Code:</label><textarea name="starter_code"></textarea>

      <h4>Test Cases (Required for Coding Questions)</h4>
      <label>Test Case 1 Input:</label><textarea name="tc1_in"></textarea>
      <label>Test Case 1 Expected Output:</label><textarea name="tc1_out"></textarea>

      <label>Test Case 2 Input:</label><textarea name="tc2_in"></textarea>
      <label>Test Case 2 Expected Output:</label><textarea name="tc2_out"></textarea>

      <label>Test Case 3 Input:</label><textarea name="tc3_in"></textarea>
      <label>Test Case 3 Expected Output:</label><textarea name="tc3_out"></textarea>
    </div>

    <button type="submit">Add Question</button>
  </form>

  <!-- Back to dashboard dynamically -->
  <a href="<%= user.role === 'admin' ? '/admin' : '/teacher-dashboard' %>">← Back to Dashboard</a>
</body>

</html>