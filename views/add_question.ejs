<!DOCTYPE html>
<html>

<head>
  <title>Add Question</title>
  <style>
    body {
      font-family: 'Arial', sans-serif;
      background-color: #e6e6fa;
      color: #4a235a;

      padding: 20px;
    }

    h1,
    h4 {
      color: #716499;
    }

    label {
      font-weight: bold;
      color: #716499;
    }

    input,
    select,
    textarea {
      width: 100%;
      margin: 5px 0 15px 0;
      padding: 12px;
      border-radius: 6px;
      border: 1px solid #c9b1de;
      background-color: #fdfefe;
      color: #4a235a;
      outline: none;
      box-sizing: border-box;
    }

    button {
      background-color: #b8c0ff;
      color: #4a235a;
      border: none;
      padding: 12px 20px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 16px;
      font-weight: bold;
      transition: 0.3s;
      width: 100%;
    }

    button:hover {
      background-color: #9ba7f5;
      color: #fff;
    }

    a {
      display: inline-block;
      margin-top: 15px;
      text-decoration: none;
      color: #716499;
      font-weight: bold;
    }

    a:hover {
      text-decoration: underline;
    }
  </style>
</head>

<body>
  <h1>Add Question</h1>

  <form action="/add-question" method="POST">
    <label>Course:</label>
    <select name="course_id" required>
      <% courses.forEach(c=> { %>
        <option value="<%= c.id %>" <%=preCourseId==c.id ? 'selected' : '' %>>
          <%= c.course_name %>
        </option>
        <% }) %>
    </select>

    <label>Level:</label>
    <select name="level" required>
      <% let maxL=10; if(preCourseId !=0) { const c=courses.find(cr=> cr.id == preCourseId); if(c) maxL = c.levels; } %>
        <% for(let i=1; i<=maxL; i++) { %>
          <option value="<%= i %>" <%=preLevelNum==i ? 'selected' : '' %>>Level <%= i %>
          </option>
          <% } %>
    </select>

    <input type="hidden" name="question_type" value="mcq">

    <div id="mcq_fields">
      <label>Question:</label><textarea name="question" required></textarea>
      <input type="text" name="option1" placeholder="Option 1" required>
      <input type="text" name="option2" placeholder="Option 2" required>
      <input type="text" name="option3" placeholder="Option 3" required>
      <input type="text" name="option4" placeholder="Option 4" required>
      <input type="number" name="correct" min="1" max="4" placeholder="Correct Option" required>
    </div>

    <button type="submit">Add Question</button>
  </form>

  <!-- Back to dashboard dynamically -->
  <a href="<%= user.role === 'admin' ? '/admin' : '/teacher-dashboard' %>">← Back to Dashboard</a>
</body>

</html>