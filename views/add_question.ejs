<!DOCTYPE html>
<html>
<head>
  <title>Add Question</title>
</head>
<body>
<h1>Add Question</h1>
<form action="/add-question" method="POST">
  <label>Course:</label>
  <select name="course_id" required>
    <% courses.forEach(c=>{ %>
      <option value="<%=c.id%>"><%=c.course_name%></option>
    <% }) %>
  </select><br><br>

  <label>Level:</label>
  <select name="level" required>
    <% for(let i=1;i<=10;i++){ %>
      <option value="<%=i%>"><%=i%></option>
    <% } %>
  </select><br><br>

  <label>Question Type:</label>
  <select id="question_type" name="question_type" required>
    <option value="">--Select--</option>
    <option value="mcq">MCQ</option>
    <option value="coding">Coding</option>
  </select><br><br>

  <div id="mcq_fields">
    <label>Question:</label><textarea name="question"></textarea><br>
    <input type="text" name="option1" placeholder="Option1"><br>
    <input type="text" name="option2" placeholder="Option2"><br>
    <input type="text" name="option3" placeholder="Option3"><br>
    <input type="text" name="option4" placeholder="Option4"><br>
    <input type="number" name="correct" min="1" max="4" placeholder="Correct Option"><br>
  </div>

  <div id="coding_fields">
    <label>Coding Question:</label><textarea name="coding_question"></textarea><br>
    <label>Starter Code:</label><textarea name="starter_code"></textarea><br>
  </div>

  <button type="submit">Add Question</button>
</form>
<a href="/teacher-dashboard">Back to Dashboard</a>

<script>
  const qType = document.getElementById("question_type");
  const mcqFields = document.getElementById("mcq_fields");
  const codingFields = document.getElementById("coding_fields");
  qType.addEventListener("change", function() {
    mcqFields.style.display = qType.value === "mcq" ? "block" : "none";
    codingFields.style.display = qType.value === "coding" ? "block" : "none";
  });
</script>
</body>
</html>
